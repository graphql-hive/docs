---
import "../styles/global.css";

import CopyMarkdown from "../components/CopyMarkdown.astro";
import DocsSearchModal from "../components/DocsSearchModal.astro";
import DocsNavigationTree from "../components/DocsNavigationTree.astro";
import HeadingPermalinks from "../components/HeadingPermalinks.astro";
import SiteFooter from "../components/SiteFooter.astro";
import SiteNavigation from "../components/SiteNavigation.astro";
import SocialMetadata from "../components/SocialMetadata.astro";
import ThemeToggle from "../components/ThemeToggle.astro";
import ThemeInit from "../components/ThemeInit.astro";
import type { DocsNavNode, DocsNavPage } from "../lib/docs-nav";

interface Heading {
  depth: number;
  slug: string;
  text: string;
}

interface Props {
  currentPath: string;
  description?: string;
  githubUrl: string;
  headings: Heading[];
  markdownUrl: string;
  navItems: DocsNavPage[];
  navTree: DocsNavNode[];
  title: string;
}

const { currentPath, description, githubUrl, headings, markdownUrl, navItems, navTree, title } = Astro.props;
const tableOfContents = headings.filter((heading) => heading.depth >= 2 && heading.depth <= 4);
const currentIndex = navItems.findIndex((item) => item.href === currentPath);
const previous = currentIndex > 0 ? navItems[currentIndex - 1] : undefined;
const next = currentIndex >= 0 ? navItems[currentIndex + 1] : undefined;
function findBreadcrumbs(nodes: DocsNavNode[]): string[] | undefined {
  for (const node of nodes) {
    if (node.type === "page") {
      if (node.href === currentPath) return [];
      continue;
    }
    if (node.href === currentPath) return [];
    const children = findBreadcrumbs(node.children);
    if (children) return [node.title, ...children];
  }
}
const breadcrumbs = findBreadcrumbs(navTree) ?? [];
const pageTitle = `${title} | Hive`;
const titleId = title.replaceAll(/[\s.,]+/g, "-").toLowerCase();
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <ThemeInit />
    <SocialMetadata description={description ?? title} imageAlt={title} title={pageTitle} />
    <link href="/pagefind/pagefind-component-ui.css" rel="stylesheet" />
    <script is:inline src="/pagefind/pagefind-component-ui.js" type="module"></script>
  </head>
  <body class="min-h-screen bg-beige-100 font-sans text-green-1000 antialiased dark:bg-[rgb(var(--nextra-bg))] dark:text-neutral-200" data-docs data-theme-enabled>
    <div
      class="grid min-h-(--fd-docs-height) auto-cols-auto auto-rows-auto overflow-x-clip transition-[grid-template-columns] [--fd-docs-height:100dvh] [--fd-docs-row-1:var(--fd-banner-height,0px)] [--fd-docs-row-2:var(--fd-docs-row-1)] [--fd-docs-row-3:calc(var(--fd-docs-row-2)+var(--fd-toc-popover-height))] [--fd-header-height:0px] [--fd-sidebar-col:var(--fd-sidebar-width)] [--fd-sidebar-width:0px] [--fd-toc-popover-height:0px] [--fd-toc-width:0px] md:[--fd-sidebar-width:268px] xl:[--fd-toc-width:268px]"
      id="nd-docs-layout"
      style={`grid-template: "nav nav nav" "sidebar toc-popover toc" "sidebar main toc" 1fr / var(--fd-sidebar-col) minmax(0, 1fr) minmax(min-content, var(--fd-toc-width))`}
    >
      <SiteNavigation docsNavigation={navItems} docsNavigationTree={navTree} />

      <div class="pointer-events-none sticky top-(--fd-docs-row-1) z-10 h-[calc(var(--fd-docs-height)-var(--fd-docs-row-1))] [grid-area:sidebar] *:pointer-events-auto max-md:hidden">
        <aside class="absolute inset-y-0 start-0 flex w-full flex-col items-end border-e border-fd-border bg-transparent text-sm *:w-(--fd-sidebar-width)" id="nd-sidebar">
          <div class="min-h-0 flex-1 overflow-hidden">
            <nav class="size-full overflow-y-auto p-4 overscroll-contain [mask-image:linear-gradient(to_bottom,transparent,white_12px,white_calc(100%-12px),transparent)]" aria-label="Documentation">
              <div class="[&>*:not(:first-child)]:mt-0.5">
                <DocsNavigationTree currentPath={currentPath} nodes={navTree} />
              </div>
            </nav>
          </div>
          <div class="flex-col border-t border-fd-border p-4 pt-2">
            <ThemeToggle />
          </div>
        </aside>
      </div>

      {
        tableOfContents.length > 0 && (
          <details class="group sticky top-(--fd-docs-row-2) z-10 h-(--fd-toc-popover-height) [grid-area:toc-popover] max-xl:[--fd-toc-popover-height:--spacing(10)] xl:hidden" data-toc-popover>
            <summary class="flex h-10 w-full cursor-pointer list-none items-center gap-2.5 border-b bg-beige-100/80 px-4 py-2.5 text-start text-sm text-fd-muted-foreground backdrop-blur-sm focus-visible:outline-none md:px-6 dark:bg-neutral-900/80">
              <svg class="size-4 shrink-0" aria-hidden="true" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path d="M4 6h16M4 12h16M4 18h10" /></svg>
              <span class="flex-1 truncate">On this page</span>
              <svg class="size-4 shrink-0 transition-transform group-open:rotate-180" aria-hidden="true" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path d="m6 9 6 6 6-6" /></svg>
            </summary>
            <nav class="flex max-h-[50vh] flex-col overflow-auto border-b bg-beige-100 px-4 pb-4 shadow-sm md:px-6 dark:bg-neutral-900">
              {tableOfContents.map((heading) => (
                <a class="py-1.5 text-sm text-fd-muted-foreground transition-colors wrap-anywhere hover:text-fd-primary" href={`#${heading.slug}`}>{heading.text}</a>
              ))}
            </nav>
          </details>
        )
      }

      <article class="mx-auto flex w-full max-w-[900px] flex-col gap-4 px-4 py-6 [grid-area:main] md:px-6 md:pt-8 xl:px-8 xl:pb-[52px] xl:pt-8" id="nd-page" data-heading-permalinks data-pagefind-body>
        {
          currentPath !== "/docs" && (
            <nav class="flex items-center gap-1.5 text-sm text-fd-muted-foreground" aria-label="Breadcrumb">
              <a class="truncate transition-opacity hover:opacity-80" href="/docs">Docs</a>
              {breadcrumbs.map((breadcrumb) => <><span aria-hidden="true">/</span><span class="truncate">{breadcrumb}</span></>)}
              <span aria-hidden="true">/</span><span class="truncate font-medium text-fd-primary">{title}</span>
            </nav>
          )
        }
        <h1 class="text-[1.75em] font-semibold" id={titleId}>{title}</h1>
        {description && <p class="mb-8 text-lg text-fd-muted-foreground">{description}</p>}
        <div class="docs-content prose relative flex-1"><slot /></div>
        {
          (previous || next) && (
            <nav class="grid gap-4 sm:grid-cols-2" aria-label="Documentation pages">
              {previous ? <a class="flex flex-col gap-2 rounded-lg border p-4 text-sm transition-colors hover:bg-fd-accent/80 hover:text-fd-accent-foreground" href={previous.href}><span class="font-medium">← {previous.title}</span></a> : <span />}
              {next && <a class="flex flex-col gap-2 rounded-lg border p-4 text-end text-sm transition-colors hover:bg-fd-accent/80 hover:text-fd-accent-foreground" href={next.href}><span class="font-medium">{next.title} →</span></a>}
            </nav>
          )
        }
      </article>

      <aside class="sticky top-(--fd-docs-row-1) flex h-[calc(var(--fd-docs-height)-var(--fd-docs-row-1))] w-(--fd-toc-width) flex-col pt-12 pe-4 pb-2 [grid-area:toc] max-xl:hidden" id="nd-toc">
        {
          tableOfContents.length > 0 && (
            <>
              <h2 class="inline-flex items-center gap-1.5 text-sm text-fd-muted-foreground">
                <svg class="size-4" aria-hidden="true" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path d="M4 6h16M4 12h16M4 18h10" /></svg>
                On this page
              </h2>
              <div class="relative ms-px min-h-0 overflow-auto py-3 text-sm [mask-image:linear-gradient(to_bottom,transparent,white_16px,white_calc(100%-16px),transparent)] [scrollbar-width:none]">
                <div class="toc-thumb absolute top-(--fd-top) h-(--fd-height) w-0.5 rounded-e-sm bg-fd-primary transition-[top,height] ease-linear"></div>
                <nav class="flex flex-col border-s border-fd-foreground/10">
                  {tableOfContents.map((heading) => (
                    <a
                      class:list={[
                        "toc-link py-1.5 text-sm text-fd-muted-foreground transition-colors wrap-anywhere first:pt-0 last:pb-0 data-[active=true]:text-fd-primary",
                        heading.depth <= 2 ? "ps-3" : heading.depth === 3 ? "ps-6" : "ps-8",
                      ]}
                      data-toc-anchor={heading.slug}
                      href={`#${heading.slug}`}
                    >
                      {heading.text}
                    </a>
                  ))}
                </nav>
              </div>
            </>
          )
        }
        <div class="flex flex-col items-start gap-2">
          <CopyMarkdown markdownUrl={markdownUrl} />
          <a
            class="inline-flex items-center gap-2 text-sm text-fd-muted-foreground transition-colors hover:text-fd-primary focus-visible:rounded-sm focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-green-500/50"
            href={githubUrl}
            rel="noreferrer noopener"
            target="_blank"
          >
            <svg class="size-3.5" aria-hidden="true" fill="currentColor" viewBox="0 0 24 24"><path d="M12 .7a11.5 11.5 0 0 0-3.64 22.4c.58.1.79-.25.79-.56v-2.02c-3.22.7-3.9-1.37-3.9-1.37-.53-1.34-1.29-1.7-1.29-1.7-1.05-.72.08-.7.08-.7 1.16.08 1.78 1.2 1.78 1.2 1.04 1.77 2.72 1.26 3.38.96.1-.75.4-1.26.74-1.55-2.57-.3-5.27-1.28-5.27-5.68 0-1.26.45-2.28 1.19-3.09-.12-.29-.52-1.46.11-3.05 0 0 .97-.31 3.16 1.18a10.97 10.97 0 0 1 5.75 0c2.2-1.49 3.16-1.18 3.16-1.18.63 1.59.23 2.76.11 3.05.74.81 1.19 1.83 1.19 3.09 0 4.41-2.7 5.38-5.28 5.67.42.36.79 1.06.79 2.14v3.17c0 .31.21.67.8.56A11.5 11.5 0 0 0 12 .7Z" /></svg>
            View on GitHub
          </a>
        </div>
      </aside>
    </div>

    <SiteFooter class="border-t border-fd-border" />
    <DocsSearchModal />
    <HeadingPermalinks />

    <script>
      const themeMedia = matchMedia("(prefers-color-scheme: dark)");
      const applyTheme = (preference: string) => {
        const dark = preference === "dark" || (preference === "system" && themeMedia.matches);
        document.documentElement.classList.toggle("dark", dark);
        document.documentElement.classList.toggle("light", !dark);
        document.documentElement.dataset.theme = preference;
        document.documentElement.style.colorScheme = dark ? "dark" : "light";
        document.querySelectorAll<HTMLButtonElement>("[data-theme-toggle] [data-theme]").forEach((button) => {
          const active = button.dataset.theme === preference;
          button.setAttribute("aria-pressed", String(active));
          button.classList.toggle("bg-fd-accent", active);
          button.classList.toggle("text-fd-accent-foreground", active);
          button.classList.toggle("text-fd-muted-foreground", !active);
        });
      };
      const savedTheme = localStorage.getItem("theme") || "system";
      applyTheme(savedTheme);
      document.querySelectorAll<HTMLButtonElement>("[data-theme-toggle] [data-theme]").forEach((button) => {
        button.addEventListener("click", () => {
          const preference = button.dataset.theme;
          if (!preference) return;
          localStorage.setItem("theme", preference);
          applyTheme(preference);
        });
      });
      themeMedia.addEventListener("change", () => {
        if ((localStorage.getItem("theme") || "system") === "system") applyTheme("system");
      });

      const links = [...document.querySelectorAll<HTMLAnchorElement>(".toc-link")];
      const thumb = document.querySelector<HTMLElement>(".toc-thumb");
      const updateToc = () => {
        if (links.length === 0) return;
        const active = [...links].reverse().find((link) => {
          const id = link.dataset.tocAnchor;
          return id && document.getElementById(id)?.getBoundingClientRect().top! <= 140;
        }) ?? links[0];
        links.forEach((link) => link.dataset.active = String(link === active));
        if (thumb) {
          thumb.style.setProperty("--fd-top", `${active.offsetTop}px`);
          thumb.style.setProperty("--fd-height", `${active.offsetHeight}px`);
        }
      };
      updateToc();
      addEventListener("scroll", updateToc, { passive: true });
    </script>
  </body>
</html>
