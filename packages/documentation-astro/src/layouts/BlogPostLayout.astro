---
import "../styles/global.css";

import type { BlogPost } from "../lib/get-blog-posts";

import BlogPostHeader from "../components/blog/BlogPostHeader.astro";
import HeadingPermalinks from "../components/HeadingPermalinks.astro";
import SimilarPosts from "../components/blog/SimilarPosts.astro";
import GetYourAPIGameRightSection from "../components/GetYourAPIGameRightSection.astro";
import SiteFooter from "../components/SiteFooter.astro";
import SiteNavigation from "../components/SiteNavigation.astro";
import SocialMetadata from "../components/SocialMetadata.astro";

interface Heading {
  depth: number;
  slug: string;
  text: string;
}

interface Props {
  allPosts: BlogPost[];
  authors: string[];
  canonical?: string;
  date: string;
  description: string;
  image?: string;
  headings: Heading[];
  mobileImage?: string;
  socialImage?: string;
  tags: string[];
  title: string;
}

const { allPosts, authors, canonical, date, description, image, headings, mobileImage, socialImage, tags, title } = Astro.props;
const tableOfContents = headings.filter((heading) => heading.depth >= 2 && heading.depth <= 4);
const pageTitle = `${title} | GraphQL Hive Blog`;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <SocialMetadata canonical={canonical} description={description} image={socialImage} imageAlt={title} title={pageTitle} type="article" />
    <link rel="alternate" type="application/rss+xml" title="Hive Blog" href="https://the-guild.dev/graphql/hive/blog/feed.xml" />
  </head>
  <body class="min-h-screen antialiased">
    <SiteNavigation />

    <div class="text-green-1000 mx-auto w-360 max-w-full overflow-x-clip dark:text-white" data-heading-permalinks>
      <BlogPostHeader authors={authors} class="mx-auto" date={date} image={image} mobileImage={mobileImage} tags={tags} title={title} />

      <div class="blog-prose-shell mx-auto grid w-full max-w-[1436px] grid-cols-1 px-4 md:px-12 xl:grid-cols-[268px_minmax(0,900px)_268px] xl:px-0">
        <article class="prose dark:prose-invert min-w-0 w-(--article-max-width) max-w-full mx-auto xl:col-start-2" data-blog-prose>
          <slot />
        </article>

        <aside class="sticky top-(--header-height) col-start-3 row-start-1 hidden h-[calc(100vh-var(--header-height))] w-68 flex-col pb-2 pt-12 pe-4 xl:flex" id="nd-toc">
          {
            tableOfContents.length > 0 && (
              <>
                <h2 class="inline-flex items-center gap-1.5 text-sm text-fd-muted-foreground">
                  <svg class="size-4" aria-hidden="true" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path d="M4 6h16M4 12h16M4 18h10" /></svg>
                  On this page
                </h2>
                <div class="relative ms-px min-h-0 overflow-auto py-3 text-sm [mask-image:linear-gradient(to_bottom,transparent,white_16px,white_calc(100%-16px),transparent)] [scrollbar-width:none]">
                  <div class="toc-thumb absolute top-(--fd-top) h-(--fd-height) w-0.5 rounded-e-sm bg-fd-primary transition-[top,height] ease-linear"></div>
                  <nav class="flex flex-col border-s border-fd-foreground/10">
                    {tableOfContents.map((heading) => (
                      <a
                        class:list={[
                          "toc-link py-1.5 text-sm text-fd-muted-foreground no-underline transition-colors wrap-anywhere first:pt-0 last:pb-0 data-[active=true]:text-fd-primary",
                          heading.depth <= 2 ? "ps-3" : heading.depth === 3 ? "ps-6" : "ps-8",
                        ]}
                        data-toc-anchor={heading.slug}
                        href={`#${heading.slug}`}
                      >
                        {heading.text}
                      </a>
                    ))}
                  </nav>
                </div>
              </>
            )
          }
        </aside>
      </div>

      <SimilarPosts allPosts={allPosts} class="mx-4 md:mx-6" currentTags={tags} currentTitle={title} />
      <GetYourAPIGameRightSection class="light text-green-1000 dark:bg-primary/95 mx-4 sm:mb-6 md:mx-6" />
    </div>

    <SiteFooter />
    <HeadingPermalinks />

    <script>
      const links = [...document.querySelectorAll<HTMLAnchorElement>(".toc-link")];
      const thumb = document.querySelector<HTMLElement>(".toc-thumb");
      const updateToc = () => {
        if (links.length === 0) return;
        const active = [...links].reverse().find((link) => {
          const id = link.dataset.tocAnchor;
          return id && document.getElementById(id)?.getBoundingClientRect().top! <= 140;
        }) ?? links[0];
        links.forEach((link) => link.dataset.active = String(link === active));
        if (thumb) {
          thumb.style.setProperty("--fd-top", `${active.offsetTop}px`);
          thumb.style.setProperty("--fd-height", `${active.offsetHeight}px`);
        }
      };
      updateToc();
      addEventListener("scroll", updateToc, { passive: true });
    </script>
  </body>
</html>

<style>
  .blog-prose-shell {
    --article-max-width: 640px;
  }

  @media (max-width: 768px) {
    .blog-prose-shell {
      --article-max-width: calc(100vw - 2rem);
    }
  }
</style>

<style is:global>
  [data-blog-prose] {
    color: rgb(0 52 44 / 90%);
    font-size: 1rem;
    line-height: 1.75;
  }

  [data-blog-prose] > :is(h2, h3, h4, h5, h6, p, ol, ul, figure, hr, iframe):not(.hive-bleed) {
    max-width: var(--article-max-width);
    margin-inline: auto;
  }

  [data-blog-prose] > p:first-of-type {
    font-size: 1.25rem;
    line-height: 2rem;
  }

  @media (min-width: 768px) {
    [data-blog-prose] > p:first-of-type {
      font-size: 1.5rem;
    }
  }

  [data-blog-prose] :is(h2, h3, h4, h5, h6) {
    margin-top: 2em;
    margin-bottom: 1em;
    font-weight: 600;
    line-height: 1.25;
  }

  [data-blog-prose] h2 {
    font-size: 1.5rem;
    line-height: 2rem;
  }

  [data-blog-prose] h3 {
    margin-top: 2rem;
    margin-bottom: 0.75rem;
    font-size: 1.25rem;
    line-height: 2rem;
  }

  [data-blog-prose] :is(h2, h3) + :is(h3, p) {
    margin-top: 0;
  }

  [data-blog-prose] p {
    margin-top: 1.25em;
    margin-bottom: 1.25em;
  }

  [data-blog-prose] ul,
  [data-blog-prose] ol,
  [data-blog-prose] blockquote {
    margin-top: 1.25em;
    margin-bottom: 1.25em;
  }

  [data-blog-prose] ul,
  [data-blog-prose] ol {
    padding-left: 1.625em;
  }

  [data-blog-prose] ul {
    list-style: disc;
  }

  [data-blog-prose] ol {
    list-style: decimal;
  }

  [data-blog-prose] li {
    margin-block: 0.5em;
    padding-left: 0.375em;
  }

  [data-blog-prose] li > p {
    margin-top: 0.5rem;
  }

  [data-blog-prose] a {
    color: currentColor;
    text-decoration-color: var(--color-blue-700);
    text-decoration-line: underline;
    text-underline-offset: 0.125rem;
  }

  [data-blog-prose] a:hover {
    color: var(--color-blue-700);
    text-decoration: none;
  }

  [data-blog-prose] :not(pre) > code {
    padding: 0.1875rem;
    overflow-wrap: break-word;
    border: 1px solid var(--color-fd-border);
    border-radius: 0.3125rem;
    background: var(--color-neutral-100);
    font-size: 0.8125rem;
    line-height: inherit;
  }

  [data-blog-prose] :is(h2, h3, h4, h5, h6) code {
    font-size: 0.875em;
  }

  :global(.dark) [data-blog-prose] :not(pre) > code {
    background: var(--color-neutral-800);
  }

  [data-blog-prose] img {
    max-width: 100%;
    height: auto;
    margin-block: 2em;
    border-radius: 1rem;
  }

  [data-blog-prose] table {
    display: table;
    width: 100%;
    overflow: hidden;
    border: 1px solid var(--color-fd-border);
    border-radius: 0.5rem;
    border-collapse: separate;
    border-spacing: 0;
    background: var(--color-fd-card);
    font-size: 0.875rem;
    line-height: 1.5rem;
  }

  [data-blog-prose] th,
  [data-blog-prose] td {
    padding: 0.625rem;
    border-bottom: 1px solid var(--color-beige-400);
    text-align: left;
  }

  [data-blog-prose] th {
    background: var(--color-neutral-100);
    font-weight: 600;
  }

  [data-blog-prose] tr:last-child td {
    border-bottom: 0;
  }

  :global(.dark) [data-blog-prose] th {
    background: var(--color-neutral-800);
  }

  [data-blog-prose] div:has(> blockquote) {
    margin-top: 2.5rem;
    padding: 1.5rem;
    border-radius: 1rem;
    background: var(--color-beige-100);
  }

  [data-blog-prose] div:has(> blockquote) blockquote {
    display: flex;
    gap: 1.5rem;
    margin: 0;
    padding: 0;
    border: 0;
    color: var(--color-green-1000);
    font-style: normal;
    font-weight: 400;
  }

  [data-blog-prose] div:has(> blockquote) blockquote::before {
    display: flex;
    width: 3rem;
    height: 3rem;
    flex-shrink: 0;
    align-items: center;
    justify-content: center;
    padding-top: 0.5rem;
    border-radius: 1rem;
    background: var(--color-primary);
    content: "\201c";
    font-size: 2rem;
  }

  [data-blog-prose] div:has(> blockquote) blockquote > p {
    margin: 0;
  }

  [data-blog-prose] div:has(> blockquote) cite {
    display: flex;
    justify-content: flex-end;
    gap: 0.75rem;
    margin-top: 1.5rem;
    font-size: 0.875rem;
    font-style: normal;
  }

  [data-blog-prose] div:has(> blockquote) cite p {
    margin-top: 0;
  }

  @media (max-width: 639px) {
    [data-blog-prose] div:has(> blockquote) blockquote {
      flex-direction: column;
    }
  }
</style>
