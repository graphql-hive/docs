---
import "../styles/global.css";

import BlogPageHero from "../components/blog/BlogPageHero.astro";
import CompanyNewsAndPressSection from "../components/blog/CompanyNewsAndPressSection.astro";
import GetYourAPIGameRightSection from "../components/GetYourAPIGameRightSection.astro";
import SiteFooter from "../components/SiteFooter.astro";
import SiteNavigation from "../components/SiteNavigation.astro";

interface Props {
  description: string;
  title: string;
}

const { description, title } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content={description} />
    <title>{title}</title>
  </head>
  <body class="min-h-screen antialiased">
    <SiteNavigation />

    <div class="text-green-1000 mx-auto w-360 max-w-full overflow-hidden dark:text-white">
      <BlogPageHero class="mx-4 max-sm:mt-2 md:mx-6" />
      <slot />
      <CompanyNewsAndPressSection class="mx-4 md:mx-6" />
      <GetYourAPIGameRightSection class="light text-green-1000 dark:bg-primary/95 mx-4 sm:mb-6 md:mx-6" />
    </div>

    <SiteFooter />
  </body>
</html>
