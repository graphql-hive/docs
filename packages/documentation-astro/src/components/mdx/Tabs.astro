---
interface Props {
  defaultIndex?: number | string;
  items?: unknown[];
}

const { defaultIndex = 0, items = [] } = Astro.props;
const labels = items.map((item) =>
  typeof item === "string" || typeof item === "number" ? String(item) : undefined,
);
const fallbackLabels = ["Hive Gateway", "OpenTelemetry"];
---

<div class="fd-tabs" data-default-index={defaultIndex}>
  <div class="fd-tabs-list" role="tablist">
    {
      labels.map((label, index) => (
        <button aria-selected={index === Number(defaultIndex)} class="fd-tab-trigger" data-index={index} role="tab" type="button">
          {label ?? fallbackLabels[index] ?? `Option ${index + 1}`}
        </button>
      ))
    }
  </div>
  <div class="tab-panels"><slot /></div>
</div>

<script>
  function initializeTabs(root: HTMLElement) {
    const tabs = [...root.querySelectorAll<HTMLButtonElement>(":scope > .fd-tabs-list > button")];
    const panels = [...root.querySelectorAll<HTMLElement>(":scope > .tab-panels > .tab-panel")];
    const show = (index: number) => {
      tabs.forEach((tab, tabIndex) => {
        const selected = tabIndex === index;
        tab.ariaSelected = String(selected);
        tab.tabIndex = selected ? 0 : -1;
      });
      panels.forEach((panel, panelIndex) => (panel.hidden = panelIndex !== index));
    };
    tabs.forEach((tab, index) => tab.addEventListener("click", () => show(index)));
    show(Number(root.dataset.defaultIndex) || 0);
  }

  document.querySelectorAll<HTMLElement>(".fd-tabs").forEach(initializeTabs);
</script>

<style>
  .fd-tabs-list {
    display: flex;
    width: 100%;
    gap: 0.5rem;
    margin-top: 1rem;
    padding-bottom: 1px;
    overflow-x: auto;
    overflow-y: hidden;
    box-shadow: inset 0 -1px 0 var(--color-beige-400);
  }

  .fd-tab-trigger {
    position: relative;
    flex-shrink: 0;
    margin-bottom: -1px;
    padding: 0.5rem;
    border: 0;
    border-bottom: 1px solid transparent;
    border-radius: 0.25rem 0.25rem 0 0;
    background: transparent;
    color: var(--color-beige-800);
    font: inherit;
    font-weight: 500;
    line-height: 1.25rem;
    white-space: nowrap;
    cursor: pointer;
    transition: color 0.1s, border-color 0.1s;
  }

  .fd-tab-trigger:hover {
    color: black;
    border-color: var(--color-beige-400);
  }

  .fd-tab-trigger[aria-selected="true"] {
    color: var(--color-green-900);
    border-color: currentColor;
  }

  .tab-panels {
    margin-top: 1.25em;
  }
</style>
