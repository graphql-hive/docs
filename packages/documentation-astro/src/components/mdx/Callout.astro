---
import calloutCriticalRaw from "../../../../design-system/src/icons/callout-critical.svg?raw";
import calloutInfoRaw from "../../../../design-system/src/icons/callout-info.svg?raw";
import calloutNeutralRaw from "../../../../design-system/src/icons/callout-neutral.svg?raw";
import calloutSuccessRaw from "../../../../design-system/src/icons/callout-success.svg?raw";
import calloutWarningRaw from "../../../../design-system/src/icons/callout-warning.svg?raw";

interface Props {
  class?: string;
  className?: string;
  title?: string;
  type?: "critical" | "info" | "note" | "success" | "tip" | "warning";
}

const { class: className, className: reactClassName, title, type = "info" } = Astro.props;

const icons = {
  critical: calloutCriticalRaw,
  info: calloutInfoRaw,
  note: calloutNeutralRaw,
  success: calloutSuccessRaw,
  tip: calloutNeutralRaw,
  warning: calloutWarningRaw,
};
---

<aside class:list={["callout", `callout-${type}`, className, reactClassName]}>
  <span class="icon" set:html={icons[type]} />
  <div>
    {title && <strong>{title}</strong>}
    <div class="body"><slot /></div>
  </div>
</aside>

<style>
  .callout {
    display: grid;
    grid-template-columns: 1.5rem 1fr;
    gap: 0.5rem;
    margin: 1.5rem 0;
    padding: 0.75rem 0.8125rem;
    color: var(--color-info-800);
    border: 1px solid var(--color-info-500);
    border-radius: 0.5rem;
    background: color-mix(in srgb, var(--color-info-100) 50%, white);
  }

  .callout-warning {
    color: var(--color-warning-800);
    border-color: var(--color-warning-500);
    background: color-mix(in srgb, var(--color-warning-100) 35%, white);
  }

  .callout-critical {
    color: var(--color-critical-800);
    border-color: var(--color-critical-500);
    background: var(--color-critical-100);
  }

  .callout-success {
    color: var(--color-positive-800);
    border-color: var(--color-positive-500);
    background: var(--color-positive-100);
  }

  .callout-note,
  .callout-tip {
    color: var(--color-beige-900);
    border-color: var(--color-beige-500);
    background: var(--color-beige-200);
  }

  .icon {
    display: block;
    width: 1.5rem;
    height: 1.5rem;
    margin-top: 0.125rem;
  }

  .icon :global(svg) {
    display: block;
    width: 100%;
    height: 100%;
  }

  strong {
    display: block;
    margin-bottom: 0.25rem;
    font-size: 0.75rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .body {
    color: #171717;
  }

  :global(.callout p:first-child) {
    margin-top: 0;
  }

  :global(.callout p:last-child) {
    margin-bottom: 0;
  }
</style>
