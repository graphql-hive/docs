---
const props = Astro.props;
---

<div class="code-block" data-code-block>
  <pre {...props}><slot /></pre>
  <button aria-label="Copy Text" data-copy-code type="button">
    <svg data-copy-icon aria-hidden="true" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
      <rect width="14" height="14" x="8" y="8" rx="2" ry="2"></rect>
      <path d="M4 16c-1.1 0-2-.9-2-2V4c0-1.1.9-2 2-2h10c1.1 0 2 .9 2 2"></path>
    </svg>
    <svg data-check-icon aria-hidden="true" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
      <path d="m20 6-11 11-5-5"></path>
    </svg>
  </button>
</div>

<style>
  .code-block {
    position: relative;
    max-width: 100%;
    margin: 1.5rem 0;
  }

  .code-block :global(pre) {
    margin: 0;
    padding-right: 3.25rem;
  }

  button {
    position: absolute;
    z-index: 1;
    top: 0.65rem;
    right: 0.65rem;
    display: grid;
    width: 2rem;
    height: 2rem;
    padding: 0;
    cursor: pointer;
    place-items: center;
    border: 1px solid var(--border);
    border-radius: 0.45rem;
    background: rgb(23 23 26 / 85%);
    color: #a3a3a3;
    backdrop-filter: blur(8px);
    transition:
      color 100ms ease,
      opacity 100ms ease,
      transform 100ms ease;
  }

  button:hover,
  button:focus-visible,
  button[data-copied] {
    color: white;
  }

  button:focus-visible {
    outline: 2px solid var(--color-blue-500);
    outline-offset: 2px;
  }

  svg {
    width: 1rem;
    height: 1rem;
  }

  [data-check-icon],
  button[data-copied] [data-copy-icon] {
    display: none;
  }

  button[data-copied] [data-check-icon] {
    display: block;
  }

  @media (hover: hover) {
    button:not(:focus-visible, [data-copied]) {
      opacity: 0;
      transform: scale(0.95);
    }

    .code-block:hover button {
      opacity: 1;
      transform: scale(1);
    }
  }
</style>

<script>
  document.addEventListener("click", async (event) => {
    const button = (event.target as Element).closest<HTMLButtonElement>("[data-copy-code]");
    if (!button) return;

    const pre = button.closest("[data-code-block]")?.querySelector("pre");
    if (!pre) return;

    const clone = pre.cloneNode(true) as HTMLPreElement;
    clone.querySelectorAll(".nd-copy-ignore").forEach((node) => node.replaceWith("\n"));

    await navigator.clipboard.writeText(clone.textContent ?? "");
    button.dataset.copied = "";
    button.ariaLabel = "Copied Text";
    window.setTimeout(() => {
      delete button.dataset.copied;
      button.ariaLabel = "Copy Text";
    }, 1500);
  });
</script>
