---
interface Props {
  alt?: string;
  class?: string;
  className?: string;
  height?: number;
  src: string | { height?: number; src: string; width?: number };
  width?: number;
  [key: string]: unknown;
}

const {
  class: className,
  className: reactClassName,
  src,
  width,
  height,
  ...props
} = Astro.props;
const source = typeof src === "string" ? src : src.src;
const imageWidth = width ?? (typeof src === "object" ? src.width : undefined);
const imageHeight = height ?? (typeof src === "object" ? src.height : undefined);
---

<img
  {...props}
  class:list={["docs-image", className, reactClassName]}
  src={source}
  width={imageWidth}
  height={imageHeight}
  loading="lazy"
/>
