---
import { renderToStaticMarkup } from "react-dom/server";

import {
  AligentLogo,
  HemnetLogo,
  KarrotLogo,
  LinktreeLogo,
  MeetupLogo,
  NacelleLogo,
  ProdigyLogo,
  SoundYXZLogo,
  TrivagoLogo,
  WealthsimpleLogo,
} from "../../../../documentation/src/components/company-logos";

const logos = {
  aligent: AligentLogo,
  hemnet: HemnetLogo,
  karrot: KarrotLogo,
  linktree: LinktreeLogo,
  meetup: MeetupLogo,
  nacelle: NacelleLogo,
  prodigy: ProdigyLogo,
  "sound-xyz": SoundYXZLogo,
  trivago: TrivagoLogo,
  wealthsimple: WealthsimpleLogo,
} as const;

interface Props {
  class?: string;
  height?: number;
  slug: keyof typeof logos;
  title?: string;
}

const { class: className, height = 32, slug, title } = Astro.props;
const Logo = logos[slug];
const markup = renderToStaticMarkup(Logo({ className, height, title }));
---

<Fragment set:html={markup} />
