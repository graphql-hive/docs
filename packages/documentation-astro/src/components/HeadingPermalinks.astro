<script>
  const headingLinkIcon = `
    <svg aria-hidden="true" class="size-[0.7em] opacity-0 transition duration-300 group-hover:opacity-70 group-hover:duration-100 [:focus-visible>&]:opacity-70 [:active>&]:opacity-100 [[data-copied=true]>&]:opacity-100" fill="none" viewBox="0 0 15 15">
      <path d="M6.44 3.61 7.06 3c1.17-1.17 3.07-1.17 4.24 0l.7.7a3 3 0 0 1 0 4.24l-.61.62a.5.5 0 0 1-.71-.71l.62-.62a2 2 0 0 0 0-2.83l-.7-.7a2 2 0 0 0-2.84 0l-.61.62a.5.5 0 0 1-.71-.71Zm2.12 7.78-.62.61A3 3 0 0 1 3.7 12l-.7-.7a3 3 0 0 1 0-4.24l.61-.62a.5.5 0 0 1 .71.71l-.62.62a2 2 0 0 0 0 2.83l.7.7a2 2 0 0 0 2.84 0l.61-.62a.5.5 0 0 1 .71.71Zm1.06-5.3a.5.5 0 0 1 0 .7L6.09 10.33a.5.5 0 0 1-.71-.71l3.53-3.53a.5.5 0 0 1 .71 0Z" fill="currentColor" />
    </svg>`;

  document.querySelectorAll<HTMLElement>("[data-heading-permalinks] :is(h1, h2, h3, h4, h5, h6)[id]").forEach((heading) => {
    if (heading.querySelector(":scope > [data-heading-permalink]")) return;

    heading.classList.add("group");
    const container = document.createElement("span");
    container.className = "inline-block w-0 overflow-visible align-top";
    container.dataset.headingPermalink = "";
    const button = document.createElement("button");
    button.type = "button";
    button.ariaLabel = "Copy link to this section";
    button.className = "relative -ml-[0.8em] -mt-1 mr-1 rounded-md before:absolute before:inset-0 before:rounded-md before:bg-current before:opacity-0 before:transition-opacity hover:before:opacity-5 focus-visible:outline-none focus-visible:ring-2";
    button.innerHTML = headingLinkIcon;
    button.addEventListener("click", async () => {
      const url = new URL(location.href);
      url.hash = heading.id;
      await navigator.clipboard.writeText(url.toString());
      button.dataset.copied = "true";
      setTimeout(() => delete button.dataset.copied, 1500);
    });
    container.append(button);
    heading.prepend(container);
  });
</script>
