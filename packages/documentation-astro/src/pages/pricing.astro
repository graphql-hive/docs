---
import SiteNavigation from "../components/SiteNavigation.astro";
import "../styles/global.css";

import hemnetPicture from "../../../documentation/src/components/company-testimonials/hemnet-picture.webp";
import karrotPicture from "../../../documentation/src/components/company-testimonials/karrot-picture.webp";
import nacellePicture from "../../../documentation/src/components/company-testimonials/nacelle-picture.webp";
import prodigyPicture from "../../../documentation/src/components/company-testimonials/prodigy-picture.webp";
import trivagoPicture from "../../../documentation/src/components/company-testimonials/trivago-picture.webp";
import wealthsimplePicture from "../../../documentation/src/components/company-testimonials/wealthsimple-picture.webp";

const appUrl = "https://app.graphql-hive.com";
const contactUrl = "https://the-guild.dev/contact";

const plans = [
  {
    name: "Hobby",
    description: "For personal or small projects",
    price: "Free forever",
    adjustable: false,
    cta: "Get started for free",
    href: appUrl,
    features: [
      ["Operations per month", "1M operations per month"],
      ["Usage data retention", "7 days"],
      ["Features", "Full access to everything!"],
      ["Usage", "Unlimited seats, projects and organizations", "GitHub issues and chat support", "Unlimited schema pushes and checks"],
      ["Availability", "99.95% uptime for operation", "100% uptime for schema registry CDN"],
      ["SSO", "Single sign-on via Open ID provider"],
    ],
  },
  {
    name: "Pro",
    description: "For scaling API and teams",
    price: "$20",
    adjustable: true,
    cta: "Try free for 30 days",
    href: appUrl,
    features: [
      ["Operations per month", "1M operations per month", "Then $10 per million operations"],
      ["Usage data retention", "90 days"],
      ["Features", "Everything in Hobby, plus the ability to scale past 1M operations."],
      ["Usage", "Unlimited seats, projects and organizations", "GitHub issues and chat support", "Unlimited schema pushes and checks"],
      ["Availability", "99.95% uptime for operation", "100% uptime for schema registry CDN"],
      ["SSO", "Single sign-on via Open ID provider"],
    ],
  },
  {
    name: "Enterprise",
    description: "Custom plan for large companies",
    price: "Contact us",
    adjustable: true,
    cta: "Shape a custom plan for your business",
    href: contactUrl,
    features: [
      ["Operations per month", "Custom operation limit", "Large request volume discount", "Ability to exceed operation limit without loss of data"],
      ["Usage data retention", "One year or more"],
      ["Features", "Everything in Pro, plus full enterprise support."],
      ["Enterprise support", "Dedicated Slack channel for support", "White-glove onboarding", "GraphQL / APIs support and guidance from The Guild", "365, 24/7 support, SLA tailored to your needs", "Custom Data Processing Agreements (DPA)"],
      ["Availability", "99.95% uptime for operation", "100% uptime for schema registry CDN"],
      ["SSO", "Single sign-on via Open ID provider"],
      ["Customized Billing", "Flexible billing options tailored to enterprise procurement processes"],
    ],
  },
] as const;

type ComparisonRow = {
  feature: string;
  href?: string;
  values: [string, string, string];
};

const yes: [string, string, string] = ["Yes", "Yes", "Yes"];
const comparisonSections: { title: string; description: string; rows: ComparisonRow[] }[] = [
  {
    title: "Organization and Team",
    description: "Structure teams your way. No enterprise tax.",
    rows: [
      { feature: "Maximum team size", values: ["Unlimited", "Unlimited", "Unlimited"] },
      { feature: "Single Sign-On (SSO)", href: "/docs/schema-registry/management/sso-oidc-provider", values: yes },
      { feature: "Role-based Access Control (RBAC)", href: "/docs/schema-registry/management/members-roles-permissions", values: yes },
      { feature: "GraphQL Management API", href: "/docs/api-reference/graphql-api", values: yes },
    ],
  },
  {
    title: "Projects",
    description: "Experiment, iterate and ship to production in no time.",
    rows: [
      { feature: "Maximum subgraph count", values: ["Unlimited", "Unlimited", "Unlimited"] },
      { feature: "Subgraph/schema publishes", href: "/docs/schema-registry#publish-a-schema", values: ["Unlimited", "Unlimited", "Unlimited"] },
      { feature: "Subgraph/schema checks", href: "/docs/schema-registry#check-a-schema", values: ["Unlimited", "Unlimited", "Unlimited"] },
      { feature: "Schema Contracts", href: "/docs/schema-registry/contracts", values: ["Unlimited", "Unlimited", "Unlimited"] },
      { feature: "Schema Linting", href: "/docs/schema-registry/schema-policy", values: yes },
      { feature: "Manage Persisted Documents", href: "/docs/schema-registry/app-deployments", values: yes },
    ],
  },
  {
    title: "Analytics, Monitoring & Metrics",
    description: "Monitor and evolve your schema in a flexible way.",
    rows: [
      { feature: "Operation usage reporting and insights", href: "/docs/schema-registry/usage-reporting", values: yes },
      { feature: "Usage reporting per month", values: ["1M operations", "1M, then $10 per 1 million", "Volume discount negotiable"] },
      { feature: "Schema usage data retention", values: ["7 days", "90 days", "One-year minimum, customizable"] },
      { feature: "Traffic-based breaking change detection", href: "/docs/schema-registry/management/targets#conditional-breaking-changes", values: ["7 days", "90 days", "One-year minimum, customizable"] },
      { feature: "Persisted Document breaking change detection", href: "/docs/schema-registry/app-deployments#schema-checks-and-affected-app-deployments", values: yes },
      { feature: "Schema check retention", values: ["7 days", "90 days", "One-year minimum, customizable"] },
    ],
  },
  {
    title: "Gateway",
    description: "Performant and extendible. Stress-tested in production.",
    rows: [
      { feature: "Self-host", values: yes },
      { feature: "Apollo Federation v1 support", values: yes },
      { feature: "Apollo Federation v2 support", values: yes },
      { feature: "Subscriptions over WebSocket and SSE", href: "/docs/gateway/subscriptions", values: yes },
      { feature: "JWT authentication", href: "/docs/gateway/authorization-authentication", values: yes },
      { feature: "Role-based Access Control", href: "/docs/gateway/authorization-authentication", values: yes },
      { feature: "Persisted documents", href: "/docs/gateway/persisted-documents", values: yes },
      { feature: "OpenTelemetry tracing", href: "/docs/gateway/monitoring-tracing#opentelemetry-traces", values: yes },
      { feature: "Prometheus metrics", href: "/docs/gateway/monitoring-tracing#prometheus-metrics", values: yes },
      { feature: "Demand control", href: "/docs/gateway/other-features/security/demand-control", values: yes },
      { feature: "Rate limiting", href: "/docs/gateway/other-features/security/rate-limiting", values: yes },
      { feature: "Subgraph request signing", href: "/docs/gateway/other-features/security/hmac-signature", values: yes },
      { feature: "Response caching", href: "/docs/gateway/other-features/performance/response-caching", values: yes },
      { feature: "Incremental Delivery (Defer & Stream)", href: "/docs/gateway/defer-stream", values: yes },
      { feature: "Custom plugins", href: "/docs/gateway/other-features/custom-plugins", values: yes },
    ],
  },
  {
    title: "Availability",
    description: "Engineered for uninterrupted performance and reliability.",
    rows: [
      { feature: "Support SLA", values: ["Pre-defined SLA", "Pre-defined SLA", "Tailored to your needs"] },
      { feature: "100% uptime of schema registry CDN", values: yes },
      { feature: "99.95% uptime for usage/analytics", values: ["No", "No", "Yes"] },
      { feature: "99.95% uptime for dashboard", values: ["No", "No", "Yes"] },
    ],
  },
  {
    title: "Support",
    description: "You can rely on us when you need help.",
    rows: [
      { feature: "GitHub issues and chat support", values: yes },
      { feature: "Dedicated Slack channel for support", values: ["No", "No", "Yes"] },
      { feature: "White-glove onboarding", values: ["No", "No", "Yes"] },
      { feature: "Technical Account Manager & guidance from The Guild", values: ["No", "No", "Yes"] },
      { feature: "Flexible billing options & extended procurement processes", values: ["No", "No", "Yes"] },
      { feature: "Custom Data Processing Agreements (DPA)", values: ["No", "No", "Yes"] },
    ],
  },
  {
    title: "Compliance / Security",
    description: "Enterprise-grade software, affordable for everyone.",
    rows: [
      { feature: "SOC 2 Type II Certified", href: "https://security.graphql-hive.com", values: yes },
      { feature: "Audit logs", href: "/docs/schema-registry/management/audit-logs", values: yes },
    ],
  },
];

const testimonials = [
  {
    company: "Hemnet",
    image: hemnetPicture,
    href: "/case-studies/hemnet",
    text: "We expected that moving from Apollo Router to a Hive Gateway would come with a measurable performance cost, but found the Hive Gateway running with less than 30% resource usage than Apollo Router while holding tens of thousands of requests per minute.",
  },
  {
    company: "trivago",
    image: trivagoPicture,
    href: "/case-studies/trivago",
    text: "Most GraphQL Gateway discussions focus on customer-facing applications. trivago's internal GraphQL Gateway use case and perspective were different, and Hive met those demands.",
  },
  {
    company: "Wealthsimple",
    image: wealthsimplePicture,
    href: "/case-studies/wealthsimple",
    text: "Hive enables Wealthsimple to build flexible and resilient GraphQL APIs. Conditional breaking changes let us focus on schema design and confidently evolve our schemas.",
  },
  {
    company: "nacelle",
    image: nacellePicture,
    text: "Our migration from Apollo GraphOS to Hive was incredibly straightforward. In less than a month, we had about 20 subgraphs running on Hive in production. The team's openness to feedback fostered a real sense of collaboration and partnership.",
  },
  {
    company: "Karrot",
    image: karrotPicture,
    text: "We use Hive as a schema registry and monitoring tool. We can inspect operation latency and deprecated field usage, and integrations with Slack and GitHub make Hive Console easy to use.",
  },
  {
    company: "Prodigy",
    image: prodigyPicture,
    text: "Hive is essential to us handling more than 750M GraphQL requests every month. We ship with certainty that schema changes will not break clients.",
    metric: ">750M requests every month",
  },
];

const faqs = [
  ["What does \"no vendor lock-in\" mean?", "We value your flexibility and independent decision-making. We will never lock you into our ecosystem and continuously add support for other tools, so you decide what your stack should look like."],
  ["Can Hive Console be self-hosted?", "Yes. The on-premise version, identical to Hive Cloud, is free and open source."],
  ["What counts as a GraphQL operation?", "Every GraphQL request processed by your API and reported to Hive Console. If your server receives 1M GraphQL requests, all of them are reported to Hive, assuming no sampling."],
  ["Are you SOC-2 Type II compliant?", "Hive Platform is fully SOC-2 Type II compliant."],
  ["Do you have a GraphQL Gateway?", "Yes. Hive Gateway, previously known as GraphQL Mesh, supports Apollo Federation and has been battle-tested by our clients for years."],
] as const;

const questionId = (question: string) =>
  `faq--${question.toLowerCase().replaceAll(/[^a-z0-9]+/g, "-").replaceAll(/(^-|-$)/g, "")}`;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content="Honest pricing plans for GraphQL Federation and other GraphQL APIs, supporting developers to enterprise with Open-Source schema registry, analytics, and gateway solutions" />
    <link rel="canonical" href="https://the-guild.dev/graphql/hive/pricing" />
    <meta property="og:title" content="Hive Platform Pricing | Hive" />
    <meta property="og:description" content="Honest usage-based pricing for GraphQL APIs, from hobby projects to enterprise platforms." />
    <meta property="og:type" content="website" />
    <meta property="og:url" content="https://the-guild.dev/graphql/hive/pricing" />
    <meta name="twitter:card" content="summary_large_image" />
    <title>Hive Platform Pricing | Hive</title>
  </head>
  <body class="pricing-body bg-white font-sans text-green-1000 [color-scheme:light]">
    <SiteNavigation />
    <main class="pricing-page mx-auto w-full max-w-[90rem] overflow-hidden">
      <header class="hero relative isolate m-6 grid min-h-[27rem] place-content-center overflow-hidden rounded-3xl bg-beige-100 px-8 py-20 text-center max-md:min-h-80 max-md:px-6 max-md:py-16 max-[32rem]:mx-3">
        <div class="arch arch-left absolute -top-52 -left-20 -z-1 aspect-square w-76 rounded-full border-[3.5rem] border-white/70"></div>
        <div class="arch arch-right absolute -right-24 -bottom-52 -z-1 aspect-square w-76 rounded-full border-[3.5rem] border-white/70"></div>
        <h1 class="mx-auto max-w-3xl text-4xl leading-[1.2] tracking-[-0.64px] md:text-[4rem] md:leading-[1.1875]">Honest pricing plans for your API management</h1>
        <p class="mx-auto mt-8 text-[1.1rem] text-green-700">From hobbyists to enterprises, enjoy all features and usage-based pricing.</p>
      </header>

      <section class="pricing-section mx-auto w-[min(75rem,calc(100%-3rem))] py-[clamp(4rem,9vw,8rem)] max-[32rem]:w-[calc(100%-1.5rem)] max-[32rem]:pt-16" aria-labelledby="operations-heading">
        <div class="section-heading max-w-240">
          <h2 class="text-4xl leading-[1.2] tracking-[-0.48px] md:text-5xl md:leading-[1.16667]" id="operations-heading">Operations: learn more about usage-based pricing</h2>
          <p class="text-[1.05rem] text-green-700">Hive Console is completely free to use. We charge only for operations collected and processed.</p>
        </div>

        <div class="calculator my-6 mt-12 rounded-2xl border border-beige-400 bg-beige-100 p-6">
          <div class="calculator-label flex items-center justify-between gap-4 font-[650] max-md:flex-col max-md:items-start">
            <label for="operations">How many operations per month do you need?</label>
            <output class="rounded-[.55rem] bg-blue-300 px-[.8rem] py-2 text-green-1000 tabular-nums [&_span]:text-xs [&_span]:font-medium [&_span]:text-green-700 max-md:[&_span]:hidden" for="operations" id="operations-output">1M <span>operations per month</span></output>
          </div>
          <input class="hive-focus my-[2rem] mb-[.35rem] h-2 w-full cursor-grab appearance-none rounded-full bg-[linear-gradient(to_right,var(--color-blue-800)_var(--range-progress),var(--color-beige-400)_var(--range-progress))] [--range-progress:0%] [&::-moz-range-thumb]:size-[1.6rem] [&::-moz-range-thumb]:appearance-none [&::-moz-range-thumb]:rounded-full [&::-moz-range-thumb]:border-5 [&::-moz-range-thumb]:border-blue-800 [&::-moz-range-thumb]:bg-white [&::-webkit-slider-thumb]:size-[1.6rem] [&::-webkit-slider-thumb]:appearance-none [&::-webkit-slider-thumb]:rounded-full [&::-webkit-slider-thumb]:border-5 [&::-webkit-slider-thumb]:border-blue-800 [&::-webkit-slider-thumb]:bg-white" id="operations" type="range" min="1" max="1000" step="1" value="1" aria-describedby="operations-note" />
          <div class="range-labels flex justify-between text-xs text-green-600"><span>1M</span><span>1B</span></div>
          <details class="operations-note relative mt-5 w-fit text-sm text-blue-900" id="operations-note">
            <summary class="hive-focus cursor-pointer font-[650]">Learn about operations</summary>
            <p class="mt-3 w-[min(32rem,calc(100vw-5rem))] rounded-xl border border-beige-400 bg-white p-4 leading-6 text-green-900">Every GraphQL request processed by your API and reported to Hive Console. If your server receives 1M GraphQL requests, all of them are reported to Hive, assuming no sampling.</p>
          </details>
          <aside class="enterprise-hint mt-4 rounded-xl bg-info-100 p-4 leading-6 text-info-800" hidden>
            <strong class="block text-green-1000">Consider using our Enterprise plan.</strong>
            For volumes over 300M operations per month, Enterprise is cheaper, with bulk discounts, dedicated support, and custom SLAs.
          </aside>
        </div>

        <div class="plan-grid flex snap-x snap-proximity gap-6 overflow-x-auto px-[.2rem] py-6 max-md:grid max-md:overflow-visible" id="plan-grid">
          {plans.map((plan) => (
            <article class="plan-card min-w-[23.75rem] snap-start rounded-3xl bg-green-400 p-px [&.is-recommended]:bg-[linear-gradient(to_bottom,var(--color-blue-600),var(--color-beige-400),var(--color-primary))] [&.is-recommended_.recommended]:h-[1.8rem] [&.is-recommended_.recommended]:pt-[.45rem] max-md:min-w-0" data-plan={plan.name}>
              <div class="recommended h-0 overflow-hidden text-center text-[.72rem] font-[750] tracking-[.1em] text-white uppercase transition-[height,padding] duration-200 ease-[var(--hive-ease-overshoot-a-bit)] motion-reduce:transition-none" aria-hidden="true">Recommended</div>
              <div class="plan-card-inner h-full rounded-[1.1rem] bg-white p-6 max-[32rem]:p-[1.15rem]">
                <header class="flex justify-between gap-3">
                  <div>
                    <h3 class="text-[1.65rem] tracking-[-.045em]">{plan.name}</h3>
                    <p class="mt-[.4rem] text-sm text-green-700">{plan.description}</p>
                  </div>
                  {plan.adjustable && <span class="adjustable max-w-32 self-start rounded-full bg-info-100 px-[.55rem] py-[.35rem] text-center text-[.65rem] text-info-800">Adjust at any time</span>}
                </header>
                <p class="price my-5 mt-8 min-h-[2.8rem] text-[2rem] font-[650] tracking-[-.04em] [&_small]:text-sm [&_small]:font-medium [&_small]:text-green-700" data-price={plan.name}>{plan.price}{plan.name === "Pro" && <small> / month</small>}</p>
                <a class:list={["button relative inline-flex min-h-12 w-full items-center justify-center rounded-lg px-6 py-3 font-medium leading-6 text-green-1000 no-underline focus-visible:outline-2 focus-visible:outline-offset-1 focus-visible:outline-green-800", plan.name === "Hobby" ? "button-outline border border-green-800 bg-transparent" : "button-primary bg-primary hover:bg-green-800 hover:text-white"]} href={plan.href}>{plan.cta}</a>
                <button class="feature-toggle hive-focus mt-4 hidden w-full rounded-lg border-0 bg-beige-200 p-[.7rem] font-sans font-[650] text-green-900 max-md:block" type="button" aria-expanded="false">Show key features</button>
                <ul class="plan-features mt-6 list-none p-0 max-md:hidden max-md:[.features-open_&]:block">
                  {plan.features.map(([category, ...features]) => (
                    <li class="grid gap-[.45rem] border-t border-beige-300 px-1 py-4 text-[.82rem] leading-[1.45] text-green-700 [&_i]:text-positive-dark [&_i]:not-italic [&>span]:flex [&>span]:gap-2">
                      <strong class="flex gap-2 text-green-900"><span class="feature-icon text-positive-dark">✓</span>{category}</strong>
                      {features.map((feature) => <span><i>✓</i>{feature}</span>)}
                    </li>
                  ))}
                </ul>
              </div>
            </article>
          ))}
        </div>
      </section>

      <section class="all-plans mx-6 rounded-3xl bg-green-900 px-8 py-[clamp(4rem,8vw,7rem)] text-center text-white max-[32rem]:mx-3">
        <h2 class="mb-8 text-4xl leading-[1.2] tracking-[-0.48px] md:text-5xl md:leading-[1.16667]">All plans include <span class="inline-block rounded-2xl bg-linear-to-r from-blue-300 to-blue-500 px-3 py-2 text-green-1000">every feature</span></h2>
        <p class="mx-auto max-w-3xl leading-[1.6] text-green-200">We do not gate any features. All our plans are fully-featured, with access to the community. We only charge a premium for support.</p>
      </section>

      <section class="comparison mx-auto w-[min(81rem,calc(100%-3rem))] py-[clamp(4rem,9vw,8rem)] max-[32rem]:w-[calc(100%-1.5rem)]" aria-labelledby="comparison-heading">
        <div class="comparison-intro text-center">
          <h2 class="text-4xl leading-[1.2] tracking-[-0.48px] md:text-5xl md:leading-[1.16667]" id="comparison-heading">Hive Console allows you to do so much more.<br /> On your own terms.</h2>
          <p class="mx-auto mt-6 mb-16 text-[1.05rem] text-green-700">Part of the Hive ecosystem, Hive Console is a fully-fledged solution that you can easily tailor to your needs.</p>
        </div>
        <div class="mobile-plan-switcher sticky top-[calc(var(--header-height)+.5rem)] z-3 mb-6 hidden grid-cols-3 gap-1 rounded-2xl bg-beige-100 p-2 shadow-xs max-md:grid" aria-label="Choose a plan to compare">
          {plans.map((plan, index) => <button class="hive-focus rounded-[.55rem] border-0 bg-transparent px-1 py-[.65rem] font-sans text-green-800 aria-pressed:bg-white aria-pressed:font-bold aria-pressed:text-green-1000" type="button" data-select-plan={plan.name} aria-pressed={index === 0}>{plan.name}</button>)}
          <a class="button button-primary col-span-full inline-flex min-h-12 items-center justify-center rounded-lg bg-primary px-6 py-3 font-medium leading-6 text-green-1000 no-underline hover:bg-green-800 hover:text-white focus-visible:outline-2 focus-visible:outline-offset-1 focus-visible:outline-green-800" href={appUrl} data-comparison-cta>Get started for free</a>
        </div>
        <div class="table-wrap overflow-x-auto">
          <table class="group/table w-full border-spacing-0 text-sm" data-active-plan="Hobby">
            <thead class="sticky top-(--header-height) z-2 bg-beige-200 max-md:hidden">
              <tr>
                <th class="w-[31%] rounded-l-2xl px-4 py-[1.4rem] text-left text-base">Features</th>
                {plans.map((plan, index) => <th class:list={["w-[23%] px-4 py-[1.4rem] text-left text-base", index === plans.length - 1 && "rounded-r-2xl"]} data-plan-column={plan.name}>{plan.name}</th>)}
              </tr>
            </thead>
            {comparisonSections.map((section) => (
              <tbody>
                <tr class="table-section"><th class="w-[31%] border-0 px-0 pt-12 pb-4 text-left max-md:w-full max-[32rem]:text-xs" colspan="4"><strong class="block text-[1.75rem] tracking-[-.03em] max-[32rem]:text-[1.35rem]">{section.title}</strong><span class="mt-[.4rem] block font-normal text-green-700">{section.description}</span></th></tr>
                {section.rows.map((row) => (
                  <tr>
                    <th class="w-[31%] border-b border-beige-400 p-4 text-left font-[550] max-md:w-1/2 max-[32rem]:px-2 max-[32rem]:py-[.8rem] max-[32rem]:text-xs [&_a]:decoration-blue-500 [&_a]:underline-offset-[.2em]" scope="row">{row.href ? <a class="hive-focus" href={row.href} target="_blank">{row.feature}</a> : row.feature}</th>
                    {row.values.map((value, index) => (
                      <td data-plan-column={plans[index].name} class:list={["w-[23%] border-b border-beige-400 p-4 text-center text-green-700 max-md:hidden max-md:w-1/2 max-[32rem]:px-2 max-[32rem]:py-[.8rem] max-[32rem]:text-xs", plans[index].name === "Hobby" && "max-md:group-data-[active-plan=Hobby]/table:table-cell", plans[index].name === "Pro" && "max-md:group-data-[active-plan=Pro]/table:table-cell", plans[index].name === "Enterprise" && "max-md:group-data-[active-plan=Enterprise]/table:table-cell", value === "Yes" && "yes", value === "No" && "no"]}>
                        {value === "Yes" ? <span class="inline-grid size-[1.45rem] place-items-center rounded-full bg-positive-100 font-extrabold text-positive-800" aria-label="Included">✓</span> : value === "No" ? <span class="text-2xl text-critical-800" aria-label="Not included">×</span> : value}
                      </td>
                    ))}
                  </tr>
                ))}
              </tbody>
            ))}
          </table>
        </div>
      </section>

      <section class="testimonials mx-6 rounded-3xl bg-beige-200 p-[clamp(2rem,6vw,5rem)] max-[32rem]:mx-3" aria-labelledby="testimonials-heading">
        <h2 class="text-4xl leading-[1.2] tracking-[-0.48px] md:text-5xl md:leading-[1.16667]" id="testimonials-heading">Loved by Developers, Trusted by Businesses</h2>
        <div class="testimonial-tabs my-12 flex rounded-[.9rem] bg-beige-300 p-[.35rem] max-md:mt-8 max-md:mb-6" role="tablist">
          {testimonials.map((testimonial, index) => <button class="hive-focus flex-1 cursor-pointer rounded-[.65rem] border-0 bg-transparent p-[.9rem] font-sans font-medium text-green-700 aria-selected:bg-white aria-selected:text-green-1000 aria-selected:shadow-xs max-md:px-1 max-md:py-[.65rem] max-md:text-xs" role="tab" type="button" data-testimonial-tab={index} aria-selected={index === 0}>{testimonial.company}</button>)}
        </div>
        <div class="testimonial-panels">
          {testimonials.map((testimonial, index) => (
            <article class="grid grid-cols-[18.75rem_1fr] items-center gap-[clamp(2rem,6vw,5rem)] [&[hidden]]:!hidden max-md:grid-cols-1" data-testimonial-panel={index} hidden={index !== 0}>
              <img class="w-full rounded-[1.25rem] mix-blend-multiply max-md:hidden" src={testimonial.image.src} width="300" height="300" alt="" loading="lazy" />
              <div>
                <strong class="company-name text-xl text-blue-1000">{testimonial.company}</strong>
                <blockquote class="my-6 text-[clamp(1.2rem,2.5vw,1.7rem)] leading-[1.45]">{testimonial.text}</blockquote>
                {testimonial.metric && <p class="metric text-[1.6rem] font-bold text-blue-1000">{testimonial.metric}</p>}
                {testimonial.href && <a class="button button-primary inline-flex min-h-12 items-center justify-center rounded-lg bg-primary px-6 py-3 font-medium leading-6 text-green-1000 no-underline hover:bg-green-800 hover:text-white focus-visible:outline-2 focus-visible:outline-offset-1 focus-visible:outline-green-800" href={testimonial.href}>Read the case study →</a>}
              </div>
            </article>
          ))}
        </div>
      </section>

      <section class="faq mx-auto grid w-[min(75rem,calc(100%-3rem))] grid-cols-[minmax(14rem,.7fr)_minmax(0,1.3fr)] gap-[clamp(3rem,8vw,8rem)] py-[clamp(5rem,10vw,9rem)] max-md:grid-cols-1 max-[32rem]:w-[calc(100%-1.5rem)]" aria-labelledby="faq-heading">
        <h2 class="text-4xl leading-[1.2] tracking-[-0.48px] md:text-5xl md:leading-[1.16667]" id="faq-heading">Frequently Asked Questions</h2>
        <div class="faq-list [&_details:last-child]:border-b [&_details:last-child]:border-beige-400">
          {faqs.map(([question, answer], index) => (
            <details class="group border-t border-beige-400" id={questionId(question)} itemscope itemtype="https://schema.org/Question">
              <summary class="hive-focus grid cursor-pointer list-none grid-cols-[2rem_1fr_1.5rem] items-center gap-3 py-6 font-[650]" itemprop="name"><span class="text-[.7rem] text-green-600">{String(index + 1).padStart(2, "0")}</span>{question}<i class="text-2xl not-italic transition-transform duration-200 ease-[var(--hive-ease-overshoot-a-bit)] group-open:rotate-45 motion-reduce:transition-none" aria-hidden="true">+</i></summary>
              <div class="px-8 pb-6 pl-11 leading-[1.65] text-green-700" itemprop="acceptedAnswer" itemscope itemtype="https://schema.org/Answer"><p itemprop="text">{answer}</p></div>
            </details>
          ))}
        </div>
      </section>

      <section class="final-cta relative isolate m-6 flex min-h-77 items-center justify-between gap-8 overflow-hidden rounded-3xl bg-primary p-[clamp(3rem,7vw,6rem)] text-green-1000 max-md:flex-col max-md:items-stretch max-md:text-center max-[32rem]:mx-3">
        <div class="arch arch-left absolute -bottom-52 -left-32 -z-1 aspect-square w-76 rounded-full border-[3.5rem] border-white/8"></div>
        <h2 class="max-w-[12ch] text-[40px] leading-[1.2] tracking-[-0.2px] md:text-[56px] md:leading-[1.142586] md:tracking-[-0.56px] max-md:m-auto">Get your API game right.</h2>
        <div class="flex gap-3 max-md:flex-col"><a class="button button-primary-inverted inline-flex min-h-12 items-center justify-center rounded-lg bg-green-800 px-6 py-3 font-medium leading-6 text-white no-underline hover:bg-green-700 focus-visible:outline-2 focus-visible:outline-offset-1 focus-visible:outline-green-800" href={appUrl}>Get started for free</a><a class="button button-tertiary inline-flex min-h-12 items-center justify-center rounded-lg border border-green-800 bg-transparent px-6 py-3 font-medium leading-6 text-green-1000 no-underline focus-visible:outline-2 focus-visible:outline-offset-1 focus-visible:outline-green-800" href={contactUrl}>Talk to us</a></div>
      </section>
    </main>

    <footer class="pricing-footer mx-auto flex w-[min(87rem,calc(100%-3rem))] justify-between py-12 text-green-1000 max-md:flex-col max-md:items-start max-md:gap-8">
      <strong>GraphQL Hive</strong>
      <nav class="flex flex-wrap gap-6 [&_a]:text-xs [&_a]:text-green-500 [&_a]:no-underline" aria-label="Footer"><a class="hive-focus" href="/docs">Documentation</a><a class="hive-focus" href="/pricing">Pricing</a><a class="hive-focus" href="/case-studies">Case Studies</a><a class="hive-focus" href="https://the-guild.dev/contact">Contact</a><a class="hive-focus" href="https://the-guild.dev/graphql/hive/privacy-policy.pdf">Privacy Policy</a></nav>
    </footer>

    <script>
      const range = document.querySelector<HTMLInputElement>("#operations");
      const output = document.querySelector<HTMLOutputElement>("#operations-output");
      const proPrice = document.querySelector<HTMLElement>('[data-price="Pro"]');
      const enterpriseHint = document.querySelector<HTMLElement>(".enterprise-hint");
      const cards = [...document.querySelectorAll<HTMLElement>(".plan-card")];
      const planGrid = document.querySelector<HTMLElement>("#plan-grid");

      const updatePricing = (shouldScroll = false) => {
        if (!range || !output || !proPrice || !enterpriseHint) return;
        const value = Number(range.value);
        const label = value === 1000 ? "1B" : `${value}M`;
        output.innerHTML = `${label} <span>operations per month</span>`;
        proPrice.innerHTML = `$${(20 + (value - 1) * 10).toLocaleString()}<small> / month</small>`;
        const plan = value === 1 ? "Hobby" : value <= 300 ? "Pro" : "Enterprise";
        cards.forEach((card) => card.classList.toggle("is-recommended", card.dataset.plan === plan));
        enterpriseHint.hidden = value <= 300;
        range.style.setProperty("--range-progress", `${((value - 1) / 999) * 100}%`);
        if (shouldScroll && window.innerWidth >= 640 && planGrid) {
          const card = cards.find((item) => item.dataset.plan === plan);
          if (card) planGrid.scrollTo({ behavior: "smooth", left: card.offsetLeft - planGrid.offsetLeft });
        }
      };
      range?.addEventListener("input", () => updatePricing(true));
      updatePricing();

      document.querySelectorAll<HTMLButtonElement>(".feature-toggle").forEach((button) => {
        button.addEventListener("click", () => {
          const expanded = button.getAttribute("aria-expanded") === "true";
          button.setAttribute("aria-expanded", String(!expanded));
          button.textContent = expanded ? "Show key features" : "Hide key features";
          button.closest(".plan-card")?.classList.toggle("features-open", !expanded);
        });
      });

      const table = document.querySelector<HTMLTableElement>(".comparison table");
      const comparisonCta = document.querySelector<HTMLAnchorElement>("[data-comparison-cta]");
      const planButtons = document.querySelectorAll<HTMLButtonElement>("[data-select-plan]");
      const ctas = {
        Hobby: ["Get started for free", "https://app.graphql-hive.com"],
        Pro: ["Try free for 30 days", "https://app.graphql-hive.com"],
        Enterprise: ["Shape your business", "https://the-guild.dev/contact"],
      } as const;
      planButtons.forEach((button) => button.addEventListener("click", () => {
        const plan = button.dataset.selectPlan as keyof typeof ctas;
        if (!plan || !table || !comparisonCta) return;
        table.dataset.activePlan = plan;
        planButtons.forEach((item) => item.setAttribute("aria-pressed", String(item === button)));
        comparisonCta.textContent = ctas[plan][0];
        comparisonCta.href = ctas[plan][1];
      }));

      const testimonialTabs = document.querySelectorAll<HTMLButtonElement>("[data-testimonial-tab]");
      const testimonialPanels = document.querySelectorAll<HTMLElement>("[data-testimonial-panel]");
      testimonialTabs.forEach((tab) => tab.addEventListener("click", () => {
        const selected = tab.dataset.testimonialTab;
        testimonialTabs.forEach((item) => item.setAttribute("aria-selected", String(item === tab)));
        testimonialPanels.forEach((panel) => { panel.hidden = panel.dataset.testimonialPanel !== selected; });
      }));

      const openLinkedFaq = () => {
        if (!location.hash.startsWith("#faq--")) return;
        const faq = document.querySelector<HTMLDetailsElement>(location.hash);
        if (faq) faq.open = true;
      };
      openLinkedFaq();
      window.addEventListener("hashchange", openLinkedFaq);
    </script>
  </body>
</html>
