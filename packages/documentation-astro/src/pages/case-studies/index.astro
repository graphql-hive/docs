---
import { getCollection } from "astro:content";

import "../../styles/global.css";

const stories = (await getCollection("caseStudies"))
  .map((entry) => {
    const data = entry.data as {
      category: string;
      date: Date | string;
      excerpt: string;
      title: string;
    };
    const date =
      data.date instanceof Date
        ? data.date.toISOString().slice(0, 10)
        : String(data.date);

    return {
      ...data,
      date,
      slug: entry.id.replace(/\/index$/, "").replace(/\.(md|mdx)$/, ""),
    };
  })
  .sort((a, b) => b.date.localeCompare(a.date) || a.title.localeCompare(b.title));
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta
      name="description"
      content="See the results our customers achieved by switching to Hive."
    />
    <title>Case Studies | GraphQL Hive</title>
  </head>
  <body>
    <header class="site-header">
      <a class="brand" href="/"><span>Hive</span></a>
      <nav>
        <a href="/docs">Documentation</a>
        <a aria-current="page" href="/case-studies">Case Studies</a>
        <a href="/product-updates">Product Updates</a>
      </nav>
    </header>

    <main>
      <header class="hero">
        <p class="eyebrow">Customer stories</p>
        <h1>Best teams.<br /><span>Hive-powered.</span></h1>
        <p class="intro">See the results our customers achieved by switching to Hive.</p>
        <div class="actions">
          <a class="primary" href="https://the-guild.dev/contact">Talk to us</a>
          <a href="/pricing">Explore pricing</a>
        </div>
      </header>

      <section class="stories">
        <p class="eyebrow">Explore</p>
        <h2>Customer stories</h2>
        <div class="story-grid">
          {
            stories.map((story, index) => (
              <a class:list={["story", index === 0 && "featured"]} href={`/case-studies/${story.slug}`}>
                <div class="mark">{story.category}</div>
                <div class="copy">
                  <span>{story.category}</span>
                  <h3>{story.title}</h3>
                  <p>{story.excerpt}</p>
                  <strong>Read the story →</strong>
                </div>
              </a>
            ))
          }
        </div>
      </section>
    </main>
  </body>
</html>

<style>
  .site-header {
    display: flex;
    min-height: var(--header-height);
    align-items: center;
    justify-content: space-between;
    padding: 0 1.5rem;
    border-bottom: 1px solid var(--border);
  }

  .brand {
    font-size: 1.1rem;
    font-weight: 700;
    text-decoration: none;
  }

  .brand span,
  .eyebrow,
  h1 span {
    color: var(--accent);
  }

  nav {
    display: flex;
    gap: 1.25rem;
  }

  nav a {
    color: var(--muted);
    font-size: 0.82rem;
    text-decoration: none;
  }

  nav a:hover,
  nav a[aria-current="page"] {
    color: var(--text);
  }

  main {
    width: min(76rem, calc(100% - 2rem));
    margin: 0 auto;
  }

  .hero {
    margin-top: 1rem;
    padding: clamp(4rem, 11vw, 9rem) clamp(1.5rem, 7vw, 6rem);
    overflow: hidden;
    border: 1px solid #3f4f28;
    border-radius: 1.5rem;
    background:
      radial-gradient(circle at 85% 15%, rgb(196 243 83 / 24%), transparent 28rem),
      #18210f;
  }

  .eyebrow {
    margin: 0 0 0.8rem;
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }

  h1 {
    max-width: 12ch;
    margin: 0;
    font-size: clamp(3.5rem, 9vw, 7.5rem);
    letter-spacing: -0.075em;
    line-height: 0.85;
  }

  .intro {
    max-width: 34rem;
    margin: 2rem 0;
    color: #b8c2ae;
    font-size: 1.1rem;
    line-height: 1.6;
  }

  .actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
  }

  .actions a {
    padding: 0.7rem 1rem;
    border: 1px solid #667252;
    border-radius: 0.5rem;
    font-size: 0.85rem;
    font-weight: 650;
    text-decoration: none;
  }

  .actions .primary {
    color: #111114;
    border-color: var(--accent);
    background: var(--accent);
  }

  .stories {
    padding: clamp(5rem, 10vw, 9rem) 0;
  }

  .stories > h2 {
    margin: 0 0 3rem;
    font-size: clamp(2.5rem, 6vw, 5rem);
    letter-spacing: -0.06em;
  }

  .story-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 1rem;
  }

  .story {
    display: grid;
    min-height: 24rem;
    grid-template-rows: 9rem 1fr;
    overflow: hidden;
    border: 1px solid var(--border);
    border-radius: 1rem;
    background: var(--surface);
    text-decoration: none;
  }

  .story.featured {
    grid-column: 1 / -1;
    grid-template-columns: 1fr 2fr;
    grid-template-rows: 1fr;
  }

  .story:hover {
    border-color: var(--accent);
  }

  .mark {
    display: grid;
    place-items: center;
    padding: 1.5rem;
    color: #111114;
    background: var(--accent);
    font-size: clamp(1.25rem, 3vw, 2rem);
    font-weight: 750;
    letter-spacing: -0.035em;
    text-align: center;
  }

  .copy {
    display: flex;
    flex-direction: column;
    padding: 1.5rem;
  }

  .copy span {
    color: var(--accent);
    font-size: 0.7rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .copy h3 {
    margin: 0.75rem 0;
    font-size: clamp(1.3rem, 3vw, 2rem);
    letter-spacing: -0.035em;
    line-height: 1.15;
  }

  .copy p {
    margin: 0 0 1.5rem;
    color: var(--muted);
    line-height: 1.55;
  }

  .copy strong {
    margin-top: auto;
    font-size: 0.8rem;
  }

  @media (max-width: 42rem) {
    nav a:not([aria-current="page"]) {
      display: none;
    }

    .story-grid {
      grid-template-columns: 1fr;
    }

    .story.featured {
      grid-column: auto;
      grid-template-columns: 1fr;
      grid-template-rows: 9rem 1fr;
    }
  }
</style>
