    <script>
      // Stats count-up on scroll into view
      const stats = document.querySelectorAll<HTMLElement>("[data-stat]");
      const animate = (el: HTMLElement) => {
        const target = Number(el.dataset.value);
        const decimal = el.dataset.decimal === "true";
        const duration = 2000;
        const start = performance.now();
        const step = (now: number) => {
          const progress = Math.min((now - start) / duration, 1);
          const value = target * progress;
          el.textContent = decimal ? value.toFixed(1) : String(Math.round(value));
          if (progress < 1) requestAnimationFrame(step);
        };
        requestAnimationFrame(step);
      };
      const observer = new IntersectionObserver(
        (entries) => {
          entries.forEach((entry) => {
            if (entry.isIntersecting) {
              animate(entry.target as HTMLElement);
              observer.unobserve(entry.target);
            }
          });
        },
        { threshold: 0.3 },
      );
      stats.forEach((stat) => observer.observe(stat));

      // FAQ deep-linking
      const openLinkedFaq = () => {
        if (!location.hash.startsWith("#faq--")) return;
        const faq = document.querySelector<HTMLDetailsElement>(location.hash);
        if (faq) faq.open = true;
      };
      openLinkedFaq();
      window.addEventListener("hashchange", openLinkedFaq);

      // Contact link opens Crisp chat if available
      document.querySelectorAll<HTMLAnchorElement>(".landing-contact").forEach((link) => {
        link.addEventListener("click", (event) => {
          const crisp = (globalThis as typeof globalThis & {
            $crisp?: { push(args: unknown[]): void };
          }).$crisp;
          if (crisp) {
            crisp.push(["do", "chat:open"]);
            event.preventDefault();
          }
        });
      });
    </script>
