---
import SiteFooter from "../components/SiteFooter.astro";
import SiteNavigation from "../components/SiteNavigation.astro";
import SocialMetadata from "../components/SocialMetadata.astro";
import "../styles/global.css";

import ogImage from "../../../documentation/src/routes/opengraph-image.png";
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <SocialMetadata
      description="Learn how trusted GraphQL documents reduce your API's attack surface, and how Hive Console, Router, and Gateway make them practical to adopt."
      image={ogImage}
      imageAlt="GraphQL Hive"
      title="Secure your GraphQL API with Persisted Documents | Hive"
    />
  </head>
  <body class="text-green-1000 bg-white font-sans [color-scheme:light]">
    <SiteNavigation />

    <main class="text-green-1000 light mx-auto max-w-360 overflow-hidden">
      <!-- Hero -->
      <div
        class="bg-green-1000 relative isolate flex max-w-360 flex-col gap-6 overflow-hidden rounded-3xl px-4 py-6 sm:pb-28 sm:pt-12 md:gap-8 lg:pb-[168px] lg:pt-24 mx-4 max-sm:mt-2 md:mx-6"
      >
        <div class="pointer-events-none absolute inset-0 overflow-hidden">
          <svg
            class="pointer-events-none absolute left-[-46px] top-[-20px] size-[200px] rotate-180 md:left-[-186px] md:top-[-76px] md:size-auto"
            height="432"
            preserveAspectRatio="xMidYMid meet"
            viewBox="0 0 432 432"
            width="432"
            xmlns="http://www.w3.org/2000/svg"
          >
            <path
              d="M.75 431v.25h90.24V160.868c0-38.596 31.282-69.878 69.878-69.878H431.25V.75H191.864a47.017 47.017 0 0 0-33.23 13.771l-68.07 68.071-7.972 7.971-68.07 68.071A47.018 47.018 0 0 0 .75 191.864V431Z"
              fill="url(#trusted-hero-arch-a)"
              stroke="url(#trusted-hero-arch-b)"
              stroke-width=".5"
            ></path></svg
          ><svg
            class="pointer-events-none absolute bottom-0 right-[-53px] size-[200px] md:-bottom-32 md:size-auto lg:bottom-0 lg:right-[-72px]"
            height="432"
            preserveAspectRatio="xMidYMid meet"
            viewBox="0 0 432 432"
            width="432"
            xmlns="http://www.w3.org/2000/svg"
          >
            <path
              d="M.75 431v.25h90.24V160.868c0-38.596 31.282-69.878 69.878-69.878H431.25V.75H191.864a47.017 47.017 0 0 0-33.23 13.771l-68.07 68.071-7.972 7.971-68.07 68.071A47.018 47.018 0 0 0 .75 191.864V431Z"
              fill="url(#trusted-hero-arch-a)"
              stroke="url(#trusted-hero-arch-b)"
              stroke-width=".5"
            ></path></svg
          ><svg
            class="absolute -z-10"
            height="432"
            viewBox="0 0 432 432"
            width="432"
          >
            <defs>
              <linearGradient
                gradientUnits="userSpaceOnUse"
                id="trusted-hero-arch-a"
                x1="48.5"
                x2="302.5"
                y1="53.5"
                y2="341"
              >
                <stop stop-color="#fff" stop-opacity=".1"></stop>
                <stop offset="1" stop-color="#fff" stop-opacity=".3"></stop>
              </linearGradient>
              <linearGradient
                gradientUnits="userSpaceOnUse"
                id="trusted-hero-arch-b"
                x1="1"
                x2="431"
                y1="1"
                y2="431"
              >
                <stop stop-color="#fff" stop-opacity=".1"></stop>
                <stop offset="1" stop-color="#fff" stop-opacity=".4"></stop>
              </linearGradient>
            </defs>
          </svg>
        </div>
        <h1
          class="group text-4xl leading-[1.2] md:text-[4rem] md:leading-[1.1875] tracking-[-0.64px] mx-auto max-w-3xl text-balance text-center text-white"
        >
          Secure your GraphQL API with Persisted Documents
        </h1>
        <p
          class="mx-auto w-[512px] max-w-[80%] text-center leading-6 text-white/80"
        >
          Execute only the GraphQL operations your apps need and reject everything
          else. Learn how persisted documents shrink your API's attack surface.
        </p>
        <div
          class="relative z-10 flex flex-col justify-center gap-2 px-0.5 sm:flex-row sm:gap-4"
        >
          <a
            class="relative flex items-center justify-center gap-2 text-nowrap rounded-lg px-6 py-3 font-medium leading-6 text-green-1000 bg-primary hover:bg-white focus-visible:outline-4 focus-visible:outline-offset-0 focus-visible:outline-white/40 sm:w-fit"
            href="/docs/schema-registry/app-deployments"
            title="Set up App Deployments in Hive"
            ><span
              class="absolute inset-0 rounded-lg border border-green-800"
            ></span
            >Set up App Deployments</a
          ><a
            class="relative flex items-center justify-center gap-2 text-nowrap rounded-lg px-6 py-3 font-medium leading-6 text-green-1000 bg-green-300 hover:bg-green-200 focus-visible:outline-2 focus-visible:outline-offset-1 focus-visible:outline-green-300/40 sm:w-fit"
            href="#what-are-trusted-documents"
            title="Understand the persisted documents pattern"
            ><span
              class="absolute inset-0 rounded-lg border border-green-800"
            ></span
            >Understand the pattern</a
          >
        </div>
        <div class="pointer-events-none absolute inset-0 overflow-hidden">
          <svg
            class="pointer-events-none absolute right-0 top-[-22px] overflow-visible firefox-highlight-fix"
            fill="#86B6C1"
            height="674"
            viewBox="0 0 895 674"
            width="895"
            xmlns="http://www.w3.org/2000/svg"
          >
            <g filter="url(#trusted-hero-highlight-blur)">
              <path
                d="M350 280.534C350 296.208 356.24 311.261 367.33 322.351L453.447 408.468L463.532 418.553L549.649 504.67C560.739 515.76 575.792 522 591.466 522L894 522L894 408.468L552.251 408.468C503.249 408.468 463.532 368.751 463.532 319.749L463.532 -22L350 -22L350 280.534Z"
              ></path>
            </g>
            <defs>
              <filter
                color-interpolation-filters="sRGB"
                filterUnits="userSpaceOnUse"
                height="1244"
                id="trusted-hero-highlight-blur"
                width="1244"
                x="-3.05176e-05"
                y="-372"
              >
                <feFlood flood-opacity="0" result="BackgroundImageFix"></feFlood>
                <feBlend
                  in="SourceGraphic"
                  in2="BackgroundImageFix"
                  mode="normal"
                  result="shape"
                ></feBlend>
                <feGaussianBlur
                  result="effect1_foregroundBlur"
                  stdDeviation="175"
                ></feGaussianBlur>
              </filter>
            </defs>
          </svg>
        </div>
      </div>
      <!-- Intro -->
      <div class="relative mt-6 sm:mt-[-72px]">
        <section
          id="what-are-trusted-documents"
          class="border-beige-400 isolate mx-auto w-[1200px] max-w-full rounded-3xl bg-white sm:max-w-[calc(100%-4rem)] sm:border sm:p-6"
        >
          <div
            class="relative mx-auto flex w-[1392px] max-w-full flex-col gap-x-4 gap-y-6 md:gap-y-12 lg:flex-row [@media(min-width:1400px)]:gap-x-[120px]"
          >
            <div class="flex grow flex-col gap-12 px-4 md:px-0 lg:w-[650px]">
              <h2
                class="group text-[40px] leading-[1.2] tracking-[-0.2px] text-green-1000"
              >
                What are persisted documents?
              </h2>
              <div class="mx-auto space-y-4 leading-6 text-green-800 lg:space-y-6">
                <p>
                  A GraphQL endpoint allows executing complex arbitary queries. That
                  flexibility is useful for developers, but a risk for production GraphQL
                  APIs. Unless you are running a public GraphQL API, there is no reason for an unknown client to invent an ad-hoc new
                  operation in production.
                </p>
                <p>
                    A <strong class="text-green-1000">persisted document</strong> (also referred to as <strong class="text-green-1000">trusted document</strong> or  <strong class="text-green-1000">persisted query</strong>) is a
                  query, mutation, or subscription that that has a stable ID assigned and is known by the GraphQL server or Gateway
                  before an application starts using it.
                </p>
                <p>
                  Clients send the document ID and variables instead of the document string. Your GraphQL server or gateway loads
                  the corresponding document from a persisted document store. All arbitary GraphQL operations are rejected.
                </p>
                <p>
                <strong class="text-green-1000">Executing arbitary queries belongs into the development process, not the production environment.</strong>
                </p>
              </div>
            </div>
            <div
              class="relative mx-4 overflow-hidden rounded-3xl bg-blue-400 p-6 md:ml-6 md:mr-0 lg:w-[450px] lg:shrink-0"
            >
              <div class="rounded-2xl bg-white p-5 shadow-xl">
                <p
                  class="text-xs font-semibold uppercase tracking-[0.16em] text-green-700"
                >
                  Your application
                </p>
                <div class="mt-4 rounded-xl bg-beige-100 p-4 font-mono text-sm">
                  <div class="flex items-center justify-between text-green-700">
                    <span>POST /graphql</span><span>68 bytes</span>
                  </div>
                  <div class="mt-4 leading-7">
                    <span class="text-blue-700">documentId:</span><br /><span
                      class="break-all pl-2"
                      >sha256:7c6f…a92e</span
                    ><br /><span class="text-blue-700 ">variables:</span><br /><span class="pl-2">&lbrace; …
                    &rbrace;</span>
                  </div>
                </div>
                <p
                  class="mt-6 text-xs font-semibold uppercase tracking-[0.16em] text-green-700"
                >
                  Your GraphQL endpoint
                </p>
                <div class="mt-4 space-y-2">
                  <div
                    class="flex items-center gap-3 rounded-xl border border-green-200 bg-green-50 p-4"
                  >
                    <span
                      class="grid size-7 shrink-0 place-items-center rounded-full bg-green-700 text-sm text-white"
                      >✓</span
                    >
                    <div>
                      <strong class="block font-medium">Known document</strong
                      ><span class="text-sm text-green-700"
                        >Resolve and execute</span
                      >
                    </div>
                  </div>
                  <div
                    class="flex items-center gap-3 rounded-xl border border-red-200 bg-red-50 p-4"
                  >
                    <span
                      class="grid size-7 shrink-0 place-items-center rounded-full bg-red-600 text-sm text-white"
                      >×</span
                    >
                    <div>
                      <strong class="block font-medium">Anything else</strong
                      ><span class="text-sm text-green-700"
                        >Reject before execution</span
                      >
                    </div>
                  </div>
                </div>
              </div>
              <p class="mt-4 text-center text-sm text-green-800">
                Clients send a document ID; unknown operations never reach
                execution.
              </p>
            </div>
          </div>
        </section>
      </div>
      <!-- Why persisted documents -->
      <section class="p-6 sm:py-20 md:py-24">
        <h2
          class="group text-4xl leading-[1.2] md:text-5xl md:leading-[1.16667] tracking-[-0.48px] text-balance text-center"
        >
          Why Persisted Documents?
        </h2>
        <div class="relative mx-auto mt-4 space-y-2 text-center lg:max-w-[880px]">
          <p>
            persisted documents turn your GraphQL endpoint from an open execution
            surface into an allowlist. <br />The benefits reach far beyond security.
          </p>
        </div>
        <ul
          class="mt-6 flex flex-row flex-wrap justify-center gap-2 md:mt-16 md:gap-6"
        >
          <li class="flex-1 rounded-2xl md:rounded-3xl bg-beige-100 p-6 md:p-12">
            <div
              class="w-fit rounded-lg bg-[linear-gradient(135deg,#68A8B6,#3B736A)] p-[9px] text-white"
            >
              <svg fill="none" height="24" viewBox="0 0 24 24" width="24">
                <path
                  d="M7 10V8a5 5 0 0 1 10 0v2m-11 0h12v10H6V10Z"
                  stroke="currentColor"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  stroke-width="1.6"
                ></path>
              </svg>
            </div>
            <h3
              class="mt-4 text-xl font-medium leading-[1.4] text-green-1000 md:mt-6"
            >
              Shrink the Attack Surface
            </h3>
            <div class="mt-2 space-y-2 text-green-800 md:mt-4">
              <p>
                Unknown operations never reach
                {" "}<strong>parsing, validation, planning, or execution</strong>.
                Attackers cannot craft malicious queries against your production API.
              </p>
              <p>
                The allowlist is enforced before any GraphQL query validation or execution happens.
              </p>
            </div>
          </li>
          <li
            class="flex-1 basis-full rounded-2xl md:basis-0 md:rounded-3xl bg-beige-100 p-6 md:p-12"
          >
            <div
              class="w-fit rounded-lg bg-[linear-gradient(135deg,#68A8B6,#3B736A)] p-[9px] text-white"
            >
              <svg fill="none" height="24" viewBox="0 0 24 24" width="24">
                <path
                  d="M4 12h16m0 0-5-5m5 5-5 5"
                  stroke="currentColor"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  stroke-width="1.6"
                ></path>
              </svg>
            </div>
            <h3
              class="mt-4 text-xl font-medium leading-[1.4] text-green-1000 md:mt-6"
            >
              Send Smaller Requests
            </h3>
            <div class="mt-2 space-y-2 text-green-800 md:mt-4">
              <p>
                A short document ID replaces the complete GraphQL document string on every
                request.
              </p>
              <p>
                Mobile and low-bandwidth clients pay a fraction of the payload cost
                they would otherwise send on each HTTP call.
              </p>
            </div>
          </li>
          <li
            class="flex-1 basis-full rounded-2xl md:rounded-3xl lg:basis-0 bg-beige-100 p-6 md:p-12"
          >
            <div
              class="w-fit rounded-lg bg-[linear-gradient(135deg,#68A8B6,#3B736A)] p-[9px] text-white"
            >
              <svg fill="none" height="24" viewBox="0 0 24 24" width="24">
                <path
                  d="M12 3v18M5 8l7-5 7 5M5 16l7 5 7-5"
                  stroke="currentColor"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  stroke-width="1.6"
                ></path>
              </svg>
            </div>
            <h3
              class="mt-4 text-xl font-medium leading-[1.4] text-green-1000 md:mt-6"
            >
              Know What Can Break
            </h3>
            <div class="mt-2 space-y-2 text-green-800 md:mt-4">
              <p>
                Validate schema changes against
                {" "}<strong>every operation and every active application version</strong
                >.
              </p>
              <p>
                Breaking-change checks become precise instead of speculative.
              </p>
            </div>
          </li>
        </ul>
      </section>
      <!-- How it works -->
      <div class="mx-4 md:mx-6">
      <section class="p-6 sm:py-20 md:py-24">
             <h2
               class="group text-4xl leading-[1.2] md:text-5xl md:leading-[1.16667] tracking-[-0.48px] text-balance text-center"
             >
               Adopting Persisted Documents
             </h2>
             <p
               class="relative mx-auto mt-4 max-w-[700px] text-center text-green-800"
             >
               Build an allowlist from your client operations, publish them to a store,
               and enforce it on your GraphQL endpoint.
             </p>
             <ol
               class="mt-6 flex flex-row flex-wrap justify-center gap-2 md:mt-16 md:gap-6"
             >
               <li class="flex-1 rounded-2xl bg-beige-100 p-6 md:rounded-3xl md:p-12">
                 <span class="text-sm font-medium uppercase tracking-wide text-green-700"
                   >Step 1</span
                 >
                 <h3 class="mt-2 text-xl font-medium leading-[1.4] text-green-1000">
                   Generate your document manifest
                 </h3>
                  <p class="mt-2 text-green-800">
                    Extract the reviewed GraphQL operations from your client code and
                    assign each one a stable document ID (e.g. SHA-256 hash). Generate
                    the manifest with
                    {" "}<a
                      class="hive-focus underline underline-offset-2"
                      href="https://the-guild.dev/graphql/codegen/plugins/presets/preset-client#persisted-documents"
                      target="_blank"
                      rel="noreferrer"
                      >GraphQL Code Generator</a
                    >{" "}or
                    {" "}<a
                      class="hive-focus underline underline-offset-2"
                      href="https://relay.dev/docs/guides/persisted-queries/"
                      target="_blank"
                      rel="noreferrer"
                      >Relay</a
                    >.
                  </p>
               </li>
               <li
                 class="flex-1 basis-full rounded-2xl bg-beige-100 p-6 md:basis-0 md:rounded-3xl md:p-12"
               >
                 <span class="text-sm font-medium uppercase tracking-wide text-green-700"
                   >Step 2</span
                 >
                 <h3 class="mt-2 text-xl font-medium leading-[1.4] text-green-1000">
                   Write manifest to store or registry
                 </h3>
                 <p class="mt-2 text-green-800">
                   Write the manifest to a blob storage such as S3 or use a schema registry such as
                   Hive, which futher validates the manifest against your schema, groups it by app and
                   version, and distributes the approved documents through its CDN.
                 </p>
               </li>
               <li
                 class="flex-1 basis-full rounded-2xl bg-beige-100 p-6 md:rounded-3xl md:p-12 lg:basis-0"
               >
                 <span class="text-sm font-medium uppercase tracking-wide text-green-700"
                   >Step 3</span
                 >
                 <h3 class="mt-2 text-xl font-medium leading-[1.4] text-green-1000">
                   Enforce on your GraphQL endpoint
                 </h3>
                 <p class="mt-2 text-green-800">
                   Clients send hashes instead of operation strings. Your server, router, or gateway resolves each document ID via your store or schema registry and rejects
                   anything that was not reviewed and published before execution.
                 </p>
               </li>
             </ol>
        </section>
        <div class="mt-6 md:mt-16">
          <div class="mb-6 text-center md:mb-16">
            <h2
              class="group text-4xl leading-[1.2] md:text-5xl md:leading-[1.16667] tracking-[-0.48px] text-balance"
            >
              Persisted Documents on Hive
            </h2>
            <p class="relative mx-auto mt-4 max-w-[700px] text-green-800">
              From trusted execution to publishing and runtime enforcement, see how
              each part of the workflow fits together with the Hive Platform.
            </p>
          </div>
          <!-- Open vs trusted execution -->
          <section
            class="relative isolate max-w-full rounded-none px-4 py-6 lg:px-8 lg:py-24 xl:px-16 [@media(min-width:1358px)]:px-24 flex flex-col gap-6 lg:flex-row lg:gap-12 bg-beige-100 rounded-3xl rounded-b-none"
          >
            <div
              class="mx-auto flex max-w-full shrink flex-col flex-wrap justify-center gap-x-2"
            >
              <h3
                class="group text-[40px] leading-[1.2] tracking-[-0.2px] max-w-full text-balance text-green-1000"
              >
                Arbitary vs. Allowlist Execution
              </h3>
              <div class="mt-4 max-w-full space-y-2 lg:mt-6 text-green-800">
                <p>
                  Without an allowlist, any valid operation can run. A curious
                  visitor or malicious actor has full access to your GraphQL schema and can craft potential harmful queries.
                </p>
                <p>
                  Disabling Introspection and disabling suggestions might reduce risk, but tools exist for reverse engineering the full GraphQL schema via brute-force.
                </p>
                <h4 class="pt-2 text-lg font-semibold text-green-1000">
                  What changes with persisted documents
                </h4>
                <p>
                  With persisted documents, the runtime resolves a
                  {" "}<code class="font-mono text-green-1000">documentId</code> against
                  a published allowlist. Operations that were never reviewed,
                  published, or shipped are rejected before they are ever executed.
                </p>
                <ul class="list-inside list-disc space-y-2">
                  <li>Only operations that passed code review can run</li>
                  <li>Unpublished or tampered IDs are rejected outright</li>
                  <li>No introspection-based discovery of hidden fields</li>
                </ul>
                <h4 class="pt-2 text-lg font-semibold text-green-1000">
                  Do not confuse this with APQ
                </h4>
                <p>
                  <strong class="text-green-1000"
                    >Automatic Persisted Queries are a bandwidth
                    optimization.</strong
                  >
                  {" "}An unknown ID is retried with the full query and stored
                  automatically. persisted documents are registered through an
                  authenticated delivery pipeline; production clients cannot add new
                  operations.
                </p>
              </div>
              <a
                class="relative flex items-center justify-center gap-2 text-nowrap rounded-lg px-6 py-3 font-medium leading-6 text-white bg-green-800 hover:bg-green-700 focus-visible:outline-2 focus-visible:outline-offset-1 focus-visible:outline-green-800/40 mt-6 max-xl:order-1 max-md:w-full xl:mt-12"
                href="https://benjie.dev/graphql/trusted-documents"
                target="_blank"
                rel="noreferrer"
                title="Read the persisted documents guide"
                ><span
                  class="absolute inset-0 rounded-lg border border-green-800"
                ></span
                >Read the persisted documents guide<svg
                  fill="currentColor"
                  height="24"
                  viewBox="0 0 24 24"
                  width="24"
                >
                  <path
                    d="m15.755 11.1-4.828-4.828L12.2 5l7 7-7 7-1.273-1.272 4.828-4.828H4.8v-1.8h10.955Z"
                  ></path></svg
              ></a>
            </div>
            <div class="mx-auto shrink-0 lg:w-[350px] xl:w-[450px] text-green-800">
              <div
                class="flex flex-row flex-wrap justify-normal gap-4 lg:flex-col lg:justify-start lg:gap-12"
              >
                <div class="min-w-[300px] max-w-[450px] shrink">
                  <div
                    class="z-20 block w-full space-y-3 rounded-xl bg-white p-5 font-mono text-sm shadow-xl"
                  >
                    <div
                      class="rounded-lg border border-beige-400 bg-beige-100 p-4"
                    >
                      <div class="flex items-center justify-between gap-3">
                        <span class="text-green-700">your-app</span
                        ><span class="text-green-600">200</span>
                      </div>
                      <p class="mt-2 truncate">
                        query GetAccount &lbrace; account &lbrace; id &rbrace;
                        &rbrace;
                      </p>
                    </div>
                    <div class="rounded-lg border border-red-200 bg-red-50 p-4">
                      <div class="flex items-center justify-between gap-3">
                        <span class="text-red-700">unknown-client</span
                        ><span class="text-red-700">200</span>
                      </div>
                      <p class="mt-2 truncate">
                        query ExploreAdmin &lbrace; admin &lbrace; users &rbrace;
                        &rbrace;
                      </p>
                    </div>
                    <div class="rounded-lg border border-red-200 bg-red-50 p-4">
                      <div class="flex items-center justify-between gap-3">
                        <span class="text-red-700">unknown-client</span
                        ><span class="text-red-700">200</span>
                      </div>
                      <p class="mt-2 truncate">
                        query ExpensiveSearch(first: 99999)…
                      </p>
                    </div>
                  </div>
                  <p class="mt-4 text-center text-sm">
                    Open execution: any valid operation runs, whoever sends it.
                  </p>
                </div>
                <div class="min-w-[300px] max-w-[450px] shrink">
                  <div
                    class="z-20 block w-full space-y-3 rounded-xl bg-green-1000 p-5 font-mono text-sm text-white shadow-xl"
                  >
                    <div class="rounded-lg border border-primary/30 bg-white/5 p-4">
                      <div class="flex items-center justify-between gap-3">
                        <span class="text-blue-200">sha256:2e94…ac18</span
                        ><span class="text-primary">ALLOW</span>
                      </div>
                      <p class="mt-2 text-white/65">GetAccount · web 4.8.0</p>
                    </div>
                    <div class="rounded-lg border border-white/10 bg-black/15 p-4">
                      <div class="flex items-center justify-between gap-3">
                        <span class="text-white/45">query ExploreAdmin …</span
                        ><span class="text-red-300">REJECT</span>
                      </div>
